# TruthLens AI Environment Variables
# Database (Defaults to local SQLite for instant zero-config running; supports PostgreSQL)
DATABASE_URL="file:./dev.db"
# For PostgreSQL deployment, uncomment and replace with your connection string:
# DATABASE_URL="postgresql://user:password@localhost:5432/truthlens?schema=public"

# AI Provider API Keys (Optional: TruthLens features built-in high-fidelity rule & heuristic NLP engine fallback)
# Add your Google Gemini API Key:
GEMINI_API_KEY=""

# Or add your OpenAI API Key:
OPENAI_API_KEY=""

# Search & Evidence Retrieval (Optional: for real-time web fact checking API)
TAVILY_API_KEY=""
SERPER_API_KEY=""

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin Access Key for /admin portal
ADMIN_SECRET_KEY="truthlens-admin-secret-2026"
